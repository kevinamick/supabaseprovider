{
  "name": "@kamick/supabaseprovider",
  "version": "2.0.0",
  "description": "Production-ready Yjs collaboration provider for Supabase Realtime. Works with TipTap, ProseMirror, and any Yjs editor.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "sql",
    "README.md",
    "LICENSE.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinamick/supabaseprovider.git"
  },
  "keywords": [
    "yjs",
    "y-provider",
    "tiptap",
    "prosemirror",
    "supabase",
    "realtime",
    "collaboration",
    "crdt"
  ],
  "author": "Kevin Amick",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kevinamick/supabaseprovider/issues"
  },
  "homepage": "https://github.com/kevinamick/supabaseprovider#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "lib0": "^0.2.99"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.10"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "cjs",
      "esm"
    ],
    "dts": true,
    "splitting": false,
    "sourcemap": true,
    "clean": true,
    "target": "es2020"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
